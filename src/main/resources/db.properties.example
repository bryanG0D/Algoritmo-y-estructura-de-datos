# Plantilla de configuracion de la base de datos.
#
# Cada integrante del grupo:
#   1. Copia este archivo en la misma carpeta con el nombre db.properties
#   2. Pon su propio usuario y contrasena de MySQL
#
# db.properties esta en el .gitignore: NO se sube a GitHub.

db.url=jdbc:mysql://localhost:3306/estacionamiento_inteligente?useSSL=false&serverTimezone=America/Lima&allowPublicKeyRetrieval=true
db.usuario=root
db.contrasena=

# --- Opcion nube (Aiven): comenta las 3 lineas de arriba y usa estas ---
# Host, puerto y contrasena se piden al encargado del grupo (nunca en GitHub).
# time_zone='-05:00' hace que las fechas se guarden en hora de Peru.
#db.url=jdbc:mysql://HOST:PUERTO/estacionamiento_inteligente?sslMode=REQUIRED&serverTimezone=America/Lima&sessionVariables=time_zone='-05:00'
