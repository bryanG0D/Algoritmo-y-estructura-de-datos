<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Sistema de Estacionamiento</display-name>

    <listener>
        <listener-class>com.utp.estacionamiento.util.AppContextListener</listener-class>
    </listener>

    <!-- Exige sesion iniciada en todas las paginas y Servlets, salvo el login -->
    <filter>
        <filter-name>FiltroSesion</filter-name>
        <filter-class>com.utp.estacionamiento.util.FiltroSesion</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>FiltroSesion</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.utp.estacionamiento.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.utp.estacionamiento.servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>EntradaServlet</servlet-name>
        <servlet-class>com.utp.estacionamiento.servlet.EntradaServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EntradaServlet</servlet-name>
        <url-pattern>/entrada</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SalidaServlet</servlet-name>
        <servlet-class>com.utp.estacionamiento.servlet.SalidaServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SalidaServlet</servlet-name>
        <url-pattern>/salida</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>BusquedaServlet</servlet-name>
        <servlet-class>com.utp.estacionamiento.servlet.BusquedaServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BusquedaServlet</servlet-name>
        <url-pattern>/buscar</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>MapaServlet</servlet-name>
        <servlet-class>com.utp.estacionamiento.servlet.MapaServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MapaServlet</servlet-name>
        <url-pattern>/mapa</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>VehiculoServlet</servlet-name>
        <servlet-class>com.utp.estacionamiento.servlet.VehiculoServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>VehiculoServlet</servlet-name>
        <url-pattern>/vehiculos</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>TipoVehiculoServlet</servlet-name>
        <servlet-class>com.utp.estacionamiento.servlet.TipoVehiculoServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TipoVehiculoServlet</servlet-name>
        <url-pattern>/tipos</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ReporteServlet</servlet-name>
        <servlet-class>com.utp.estacionamiento.servlet.ReporteServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReporteServlet</servlet-name>
        <url-pattern>/reporte</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ResumenServlet</servlet-name>
        <servlet-class>com.utp.estacionamiento.servlet.ResumenServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ResumenServlet</servlet-name>
        <url-pattern>/resumen</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>login.jsp</welcome-file>
    </welcome-file-list>

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

</web-app>
